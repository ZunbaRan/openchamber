# Copy to .env. These are non-production acceptance-lab credentials.
# Keep the real .env outside source control.
LOCAL_CRM_API_KEY=replace-with-a-local-full-access-key
LOCAL_CRM_READ_ONLY_KEY=replace-with-a-local-read-only-key
HOSTED_OPS_API_KEY=replace-with-a-hosted-full-access-key
HOSTED_OPS_READ_ONLY_KEY=replace-with-a-hosted-read-only-key

# The signed hosted manifest embeds this public URL. Re-run build/sign after changing it.
PUBLIC_BASE_URL=http://127.0.0.1:9510

# Generated once by init-env. For a quick tunnel, use:
# PUBLIC_BASE_URL=https://<name>.trycloudflare.com/<PUBLIC_GATE_PATH>
PUBLIC_GATE_PATH=interop-replace-with-random-24-hex-characters

# The tldraw MCP 2026 implementation is owned by the independent
# tldraw-mcp-app repository. OpenChamber consumes only its image or MCP URL.
INTEROP_TLDRAW_MCP_IMAGE=tldraw-mcp-app:local
INTEROP_TLDRAW_MCP_URL=http://127.0.0.1:39512/mcp
