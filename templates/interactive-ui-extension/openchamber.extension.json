{
  "$schema": "openchamber://extension/v1",
  "id": "__EXTENSION_ID__",
  "name": "__EXTENSION_NAME__",
  "version": "1.0.0",
  "publisher": "Your Organization",
  "agentRouting": {
    "domain": "__TOOL_PREFIX__",
    "intents": [
      "__TOOL_PREFIX__.overview",
      "__TOOL_PREFIX__.item.view",
      "__TOOL_PREFIX__.item.approve",
      "__TOOL_PREFIX__.workspace"
    ],
    "examples": {
      "en": [
        "Open the __EXTENSION_NAME__ overview",
        "Show pending __EXTENSION_NAME__ items",
        "Open the __EXTENSION_NAME__ workspace"
      ]
    },
    "dataAuthority": "connected-business-system"
  },
  "connectors": [
    {
      "id": "business-api",
      "type": "http",
      "baseUrl": "${OCIX_BUSINESS_API_URL}",
      "auth": {
        "type": "api-key",
        "placement": {
          "type": "header",
          "name": "Authorization",
          "prefix": "Bearer "
        }
      },
      "test": {
        "method": "GET",
        "path": "/interactive-ui/health"
      }
    }
  ],
  "views": [
    {
      "id": "__EXTENSION_ID__.overview",
      "runtime": "declarative",
      "entry": "ui/declarative/overview.view.json",
      "tools": ["__TOOL_PREFIX___open_overview"],
      "routing": {
        "intents": ["__TOOL_PREFIX__.overview", "__TOOL_PREFIX__.item.view"],
        "priority": 80,
        "operation": "read"
      },
      "displayModes": ["inline", "workspace"]
    },
    {
      "id": "__EXTENSION_ID__.workspace",
      "runtime": "native",
      "entry": "dist/ui.mjs",
      "export": "extension",
      "tools": ["__TOOL_PREFIX___open_workspace"],
      "routing": {
        "intents": ["__TOOL_PREFIX__.workspace", "__TOOL_PREFIX__.item.approve"],
        "priority": 85,
        "operation": "mixed"
      },
      "displayModes": ["inline", "workspace", "fullscreen"]
    }
  ],
  "actions": [
    {
      "id": "__EXTENSION_ID__.overview.query",
      "connector": "business-api",
      "risk": "read",
      "permission": "allow",
      "request": {
        "method": "POST",
        "path": "/interactive-ui/overview"
      }
    },
    {
      "id": "__EXTENSION_ID__.item.approve",
      "connector": "business-api",
      "risk": "write",
      "permission": "ask",
      "request": {
        "method": "POST",
        "path": "/interactive-ui/items/approve"
      },
      "confirmation": {
        "title": "Confirm this business update?",
        "description": "This action writes to the connected enterprise system."
      }
    }
  ],
  "permissions": {
    "network": ["${OCIX_BUSINESS_API_URL}"]
  },
  "trust": {
    "mode": "native-code",
    "signature": "development"
  }
}
