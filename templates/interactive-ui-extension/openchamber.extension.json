{
  "$schema": "openchamber://extension/v1",
  "id": "__EXTENSION_ID__",
  "name": "__EXTENSION_NAME__",
  "shortName": "__EXTENSION_NAME__",
  "version": "1.0.0",
  "publisher": "Your Organization",
  "agentRouting": {
    "domain": "__TOOL_PREFIX__",
    "intents": [
      "__TOOL_PREFIX__.overview",
      "__TOOL_PREFIX__.item.view",
      "__TOOL_PREFIX__.item.approve",
      "__TOOL_PREFIX__.workspace",
      "__TOOL_PREFIX__.explorer"
    ],
    "examples": {
      "en": [
        "Open the __EXTENSION_NAME__ overview",
        "Show pending __EXTENSION_NAME__ items",
        "Open the __EXTENSION_NAME__ workspace",
        "Explore __EXTENSION_NAME__ as an interactive canvas"
      ]
    },
    "dataAuthority": "connected-business-system"
  },
  "connectors": [
    {
      "id": "business-api",
      "type": "http",
      "baseUrl": "${OCIX_BUSINESS_API_URL}",
      "auth": {
        "type": "api-key",
        "placement": {
          "type": "header",
          "name": "Authorization",
          "prefix": "Bearer "
        }
      },
      "test": {
        "method": "GET",
        "path": "/interactive-ui/health"
      }
    }
  ],
  "views": [
    {
      "id": "__EXTENSION_ID__.overview",
      "runtime": "declarative",
      "entry": "ui/declarative/overview.view.json",
      "tools": ["__TOOL_PREFIX___open_overview"],
      "routing": {
        "intents": ["__TOOL_PREFIX__.overview", "__TOOL_PREFIX__.item.view"],
        "priority": 80,
        "operation": "read"
      },
      "displayModes": ["inline", "workspace"],
      "dashboard": {
        "description": "A manually launchable overview tile for the extension Workbench.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "required": ["scope"]
        },
        "defaultContext": {
          "scope": "default"
        },
        "layout": {
          "columns": 6,
          "rows": 5,
          "minColumns": 4,
          "maxColumns": 12,
          "minRows": 3,
          "maxRows": 12,
          "overflow": "auto"
        },
        "instances": "byContext",
        "refresh": {
          "mode": "onFocus",
          "minimumIntervalSeconds": 30
        },
        "events": {
          "emits": [
            {
              "id": "item.selected",
              "payloadSchema": {
                "type": "object",
                "properties": {
                  "itemId": { "type": "string", "minLength": 1, "maxLength": 160 }
                },
                "required": ["itemId"]
              }
            }
          ],
          "accepts": []
        },
        "popout": {
          "supported": true
        }
      }
    },
    {
      "id": "__EXTENSION_ID__.workspace",
      "runtime": "native",
      "entry": "dist/ui.mjs",
      "export": "extension",
      "tools": ["__TOOL_PREFIX___open_workspace"],
      "routing": {
        "intents": ["__TOOL_PREFIX__.workspace", "__TOOL_PREFIX__.item.approve"],
        "priority": 85,
        "operation": "mixed"
      },
      "displayModes": ["inline", "workspace", "fullscreen"],
      "dashboard": {
        "description": "An item workspace opened by an Agent or a declared overview event.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "minLength": 1, "maxLength": 80 },
            "itemId": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "required": ["scope", "itemId"]
        },
        "defaultContext": {
          "scope": "default"
        },
        "layout": {
          "columns": 6,
          "rows": 6,
          "minColumns": 4,
          "maxColumns": 12,
          "minRows": 4,
          "maxRows": 16,
          "overflow": "auto"
        },
        "instances": "byContext",
        "refresh": {
          "mode": "manual",
          "minimumIntervalSeconds": 30
        },
        "events": {
          "emits": [],
          "accepts": ["item.selected"]
        },
        "popout": {
          "supported": false
        }
      }
    }
  ],
  "artifacts": [
    {
      "id": "__EXTENSION_ID__.explorer",
      "title": "__EXTENSION_NAME__ Explorer",
      "entry": "ui/artifacts/explorer.html",
      "tools": ["__TOOL_PREFIX___open_explorer"],
      "routing": {
        "intents": ["__TOOL_PREFIX__.explorer"],
        "priority": 82,
        "operation": "mixed"
      },
      "displayModes": ["inline", "workspace", "fullscreen"],
      "inlineHeight": 520,
      "capabilities": {
        "scripts": true,
        "businessActions": [
          "__EXTENSION_ID__.overview.query",
          "__EXTENSION_ID__.item.approve"
        ]
      },
      "dashboard": {
        "description": "A script-capable HTML Artifact that can be launched or pinned in the Workbench.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "required": ["scope"]
        },
        "defaultContext": {
          "scope": "default"
        },
        "layout": {
          "columns": 6,
          "rows": 7,
          "minColumns": 4,
          "maxColumns": 12,
          "minRows": 4,
          "maxRows": 18,
          "overflow": "auto"
        },
        "instances": "byContext",
        "refresh": {
          "mode": "manual",
          "minimumIntervalSeconds": 30
        },
        "events": {
          "emits": [],
          "accepts": []
        },
        "popout": {
          "supported": true
        }
      }
    }
  ],
  "links": [
    {
      "id": "overview-item-to-workspace",
      "from": "__EXTENSION_ID__.overview",
      "event": "item.selected",
      "to": "__EXTENSION_ID__.workspace",
      "map": {
        "scope": "$source.context.scope",
        "itemId": "$event.payload.itemId"
      },
      "relationship": "item",
      "placement": "adjacent"
    }
  ],
  "actions": [
    {
      "id": "__EXTENSION_ID__.overview.query",
      "connector": "business-api",
      "risk": "read",
      "permission": "allow",
      "request": {
        "method": "POST",
        "path": "/interactive-ui/overview"
      }
    },
    {
      "id": "__EXTENSION_ID__.item.approve",
      "connector": "business-api",
      "risk": "write",
      "permission": "ask",
      "request": {
        "method": "POST",
        "path": "/interactive-ui/items/approve"
      },
      "confirmation": {
        "title": "Confirm this business update?",
        "description": "This action writes to the connected enterprise system."
      }
    }
  ],
  "permissions": {
    "network": ["${OCIX_BUSINESS_API_URL}"]
  },
  "trust": {
    "mode": "native-code",
    "signature": "development"
  }
}
