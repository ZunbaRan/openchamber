{
  "$schema": "openchamber://extension/v1",
  "id": "com.openchamber.builtin.interactive-ui",
  "name": "OpenLoop Interactive UI",
  "version": "1.4.0",
  "agentRouting": {
    "domain": "visualization",
    "intents": [
      "visualization.compose",
      "visualization.process",
      "visualization.dashboard",
      "visualization.chart",
      "visualization.table",
      "visualization.gallery"
    ],
    "examples": {
      "zh-CN": ["画一下这个流程", "把这些数据做成图表", "可视化我提供的结果"],
      "en": ["visualize this process", "chart these results", "show this data as a dashboard"]
    },
    "dataAuthority": "generated"
  },
  "connectors": [],
  "views": [
    {
      "id": "com.openchamber.builtin.interactive-ui.gallery",
      "runtime": "declarative",
      "entry": "ui/component-gallery.view.json",
      "tools": ["interactive_ui_gallery"],
      "routing": {
        "intents": ["visualization.gallery"],
        "priority": 1,
        "operation": "read"
      },
      "displayModes": ["inline", "workspace"]
    },
    {
      "id": "com.openchamber.builtin.interactive-ui.process-flow",
      "runtime": "declarative",
      "entry": "ui/process-flow.view.json",
      "tools": ["interactive_ui"],
      "routing": {
        "intents": ["visualization.process"],
        "priority": 10,
        "operation": "read"
      },
      "displayModes": ["inline", "workspace"]
    },
    {
      "id": "com.openchamber.builtin.interactive-ui.generated",
      "runtime": "declarative",
      "entry": "ui/generated.view.json",
      "tools": ["interactive_ui"],
      "routing": {
        "intents": [
          "visualization.compose",
          "visualization.dashboard",
          "visualization.chart",
          "visualization.table"
        ],
        "priority": 10,
        "operation": "read"
      },
      "displayModes": ["inline", "workspace"]
    }
  ],
  "actions": [],
  "permissions": {
    "network": []
  },
  "trust": {
    "mode": "declarative",
    "signature": "built-in"
  }
}
