{
  "$schema": "openchamber://extension/v1",
  "id": "com.openchamber.demo.sales",
  "name": "OpenChamber Demo Sales",
  "shortName": "Sales",
  "version": "1.0.0",
  "publisher": "OpenChamber",
  "agentRouting": {
    "domain": "sales",
    "intents": [
      "sales.summary",
      "sales.dashboard",
      "sales.order.view",
      "sales.order.approve"
    ],
    "examples": {
      "zh-CN": ["查看销售概览", "打开销售看板", "检查异常订单"],
      "en": ["show the sales summary", "open the sales dashboard", "review anomalous orders"]
    },
    "dataAuthority": "connected-business-system"
  },
  "connectors": [
    {
      "id": "sales-api",
      "type": "http",
      "baseUrl": "${OCIX_DEMO_API_URL}",
      "auth": {
        "type": "env-bearer",
        "env": "OCIX_DEMO_TOKEN"
      }
    }
  ],
  "views": [
    {
      "id": "com.openchamber.demo.sales.summary",
      "title": "销售概览",
      "runtime": "declarative",
      "entry": "ui/declarative/sales-summary.view.json",
      "tools": ["sales_get_summary"],
      "routing": {
        "intents": ["sales.summary", "sales.order.view", "sales.order.approve"],
        "priority": 85,
        "operation": "mixed"
      },
      "displayModes": ["inline", "workspace"],
      "dashboard": {
        "description": "查看指定区域与月份的真实销售概览。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "region": { "type": "string", "minLength": 1, "maxLength": 80 },
            "period": { "type": "string", "minLength": 7, "maxLength": 7 }
          },
          "required": ["region", "period"]
        },
        "defaultContext": {
          "region": "east",
          "period": "2026-07"
        },
        "layout": {
          "columns": 6,
          "rows": 5,
          "minColumns": 4,
          "maxColumns": 12,
          "minRows": 3,
          "maxRows": 12,
          "overflow": "auto"
        },
        "instances": "byContext",
        "refresh": {
          "mode": "onFocus",
          "minimumIntervalSeconds": 30
        },
        "events": {
          "emits": [
            {
              "id": "order.selected",
              "payloadSchema": {
                "type": "object",
                "properties": {
                  "orderId": { "type": "string", "minLength": 1, "maxLength": 160 }
                },
                "required": ["orderId"]
              }
            }
          ],
          "accepts": []
        },
        "popout": {
          "supported": true
        }
      }
    },
    {
      "id": "com.openchamber.demo.sales.dashboard",
      "title": "销售原生工作台",
      "runtime": "native",
      "entry": "dist/ui.mjs",
      "export": "extension",
      "tools": ["sales_get_dashboard"],
      "routing": {
        "intents": ["sales.dashboard", "sales.order.view", "sales.order.approve"],
        "priority": 80,
        "operation": "mixed"
      },
      "displayModes": ["inline", "workspace", "fullscreen"],
      "dashboard": {
        "description": "需要 Agent 提供区域参数的 Trusted Native 销售工作台。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "region": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "required": ["region"]
        },
        "layout": {
          "columns": 6,
          "rows": 6,
          "minColumns": 4,
          "maxColumns": 12,
          "minRows": 4,
          "maxRows": 16,
          "overflow": "auto"
        },
        "instances": "byContext",
        "refresh": {
          "mode": "manual",
          "minimumIntervalSeconds": 30
        },
        "events": {
          "emits": [],
          "accepts": []
        },
        "popout": {
          "supported": false
        }
      }
    }
  ],
  "artifacts": [
    {
      "id": "com.openchamber.demo.sales.order-detail",
      "title": "订单详情",
      "entry": "ui/artifacts/order-detail.html",
      "tools": ["sales_get_order_detail"],
      "routing": {
        "intents": ["sales.order.view"],
        "priority": 82,
        "operation": "read"
      },
      "displayModes": ["inline", "workspace", "fullscreen"],
      "inlineHeight": 420,
      "capabilities": {
        "scripts": true,
        "businessActions": ["sales.dashboard.query"]
      },
      "dashboard": {
        "description": "从销售概览联动打开指定订单；缺少 orderId 时不能手动启动。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "region": { "type": "string", "minLength": 1, "maxLength": 80 },
            "period": { "type": "string", "minLength": 7, "maxLength": 7 },
            "orderId": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "required": ["region", "period", "orderId"]
        },
        "defaultContext": {
          "region": "east",
          "period": "2026-07"
        },
        "layout": {
          "columns": 6,
          "rows": 5,
          "minColumns": 4,
          "maxColumns": 12,
          "minRows": 3,
          "maxRows": 12,
          "overflow": "auto"
        },
        "instances": "byContext",
        "refresh": {
          "mode": "manual",
          "minimumIntervalSeconds": 30
        },
        "events": {
          "emits": [],
          "accepts": ["order.selected"]
        },
        "popout": {
          "supported": true
        }
      }
    }
  ],
  "links": [
    {
      "id": "summary-order-to-detail",
      "from": "com.openchamber.demo.sales.summary",
      "event": "order.selected",
      "to": "com.openchamber.demo.sales.order-detail",
      "map": {
        "region": "$source.context.region",
        "period": "$source.context.period",
        "orderId": "$event.payload.orderId"
      },
      "relationship": "order",
      "placement": "adjacent"
    }
  ],
  "actions": [
    {
      "id": "sales.dashboard.query",
      "connector": "sales-api",
      "risk": "read",
      "permission": "allow",
      "request": {
        "method": "POST",
        "path": "/dashboard"
      }
    },
    {
      "id": "sales.order.approve",
      "connector": "sales-api",
      "risk": "write",
      "permission": "ask",
      "request": {
        "method": "POST",
        "path": "/orders/approve"
      },
      "confirmation": {
        "title": "批准订单？",
        "description": "批准后订单将进入履约流程。"
      }
    }
  ],
  "permissions": {
    "network": ["${OCIX_DEMO_API_URL}"]
  },
  "trust": {
    "mode": "native-code",
    "signature": "development"
  }
}
